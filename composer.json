{
    "name": "codeforgestart/laravel-query-filters",
    "description": "A clean and extensible query filtering package for Laravel Eloquent.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "CodeForgeStart\\LaravelQueryFilters\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeForgeStart\\LaravelQueryFilters\\FilterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}